# Template for src-tauri/.env (copy this file to `.env` and fill in values).
# `.env` holds local-only secrets and is gitignored; this template is committed.
# Loaded at startup by dotenvy in src-tauri/src/lib.rs.

# Fish Audio TTS — API bearer token (from your fish.audio session).
FISH_AUDIO_AUTH_TOKEN=

# Fish Audio reCAPTCHA token — time-sensitive, expires within minutes.
# Can also be refreshed at runtime via the `tts_set_recaptcha` command.
FISH_AUDIO_RECAPTCHA=
