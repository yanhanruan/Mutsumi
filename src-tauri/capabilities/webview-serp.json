{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webview-serp",
  "description": "Hidden SERP-fetch window: lets the rendered search page report its HTML back to Rust via the core event plugin. Scoped to the search-engine origins only.",
  "windows": ["serp-fetcher"],
  "remote": {
    "urls": [
      "https://cn.bing.com/*",
      "https://www.bing.com/*",
      "https://www.google.com/*",
      "https://www.baidu.com/*",
      "https://html.duckduckgo.com/*"
    ]
  },
  "permissions": ["core:default", "core:event:allow-emit"]
}
