# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/Cargo.lock
src-tauri/WixTools/
src-tauri/gen/schemas/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo

# OS
.DS_Store
Thumbs.db

# Claude Code local config
.claude/

# Raw input frames and intermediate PNGs (exclude the logo image)
*.png
!app-icon-cucumber-puppy-transparent-compress.png
# …and the desktop app icons: CI release builds need them (tauri bundle.icon)
!/src-tauri/icons/*.png
frames_raw/**/*
!frames_raw/**/
!frames_raw/**/.gitkeep

# Local runtime state
state.json

# Secrets (auth tokens, reCAPTCHA, etc.) — keep .env.example committed
.env
!.env.example

# Test-only updater signing keys (generated by scripts/gen-test-keys.mjs) and
# the local fake-update-server working directory — never commit key material.
scripts/test-keys/
scripts/fake-update-dist/

# Mobile icon sets (regenerable via `npx tauri icon`; this app ships Windows-
# only). The desktop icons ARE tracked: CI release builds clone the repo and
# tauri-build hard-requires icons/icon.ico for the Windows resource file.
/src-tauri/icons/android/
/src-tauri/icons/ios/